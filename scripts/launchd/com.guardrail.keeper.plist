<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.guardrail.keeper</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/path/to/guardrail/scripts/keeper-daily.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>NODE</key><string>/path/to/node</string>
    <key>KEEPER_DELAY</key><string>60</string>
  </dict>
  <!-- Local time is IST: 05:30 IST = 00:00 UTC, with a retry at 06:00 IST = 00:30 UTC. A Mac asleep at that time runs it on wake. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>5</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>0</integer></dict>
  </array>
  <key>StandardOutPath</key><string>/path/to/guardrail/out/keeper-launchd.log</string>
  <key>StandardErrorPath</key><string>/path/to/guardrail/out/keeper-launchd.log</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
